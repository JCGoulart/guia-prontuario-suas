---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Sidebar from '@/components/astro/layout/Sidebar.astro'
import ScrollToTop from '@/components/react/layout/ScrollToTop'
import BlockAccordion from '@/components/react/layout/BlockAccordion'
import { WelcomeModal } from '@/components/react/layout/WelcomeModal'
import { BLOCK_ACCENTS } from '@/lib/constants'

import Capa from '@/components/astro/capitulos/Capa.astro'
import Expediente from '@/components/astro/capitulos/Expediente.astro'
import Sumario from '@/components/astro/capitulos/Sumario.astro'
import Apresentacao from '@/components/astro/capitulos/Apresentacao.astro'
import ProfissionaisPerfis from '@/components/astro/capitulos/ProfissionaisPerfis.astro'
import LoginSistema from '@/components/astro/capitulos/LoginSistema.astro'
import TermoUso from '@/components/astro/capitulos/TermoUso.astro'
import ContraCapa from '@/components/astro/capitulos/ContraCapa.astro'
import GestaoProntuario from '@/components/astro/capitulos/expandidas/GestaoProntuario.astro'
import DiagnosticoSocioeconomico from '@/components/astro/capitulos/expandidas/DiagnosticoSocioeconomico.astro'
import VulnerabilidadesProtecoes from '@/components/astro/capitulos/expandidas/VulnerabilidadesProtecoes.astro'
import MetodologiaAcompanhamento from '@/components/astro/capitulos/expandidas/MetodologiaAcompanhamento.astro'
import BeneficiosEventuais from '@/components/astro/capitulos/expandidas/BeneficiosEventuais.astro'
import CondicoesVida from '@/components/astro/capitulos/expandidas/CondicoesVida.astro'
import AtendimentoColetivoExpandido from '@/components/astro/capitulos/expandidas/AtendimentoColetivoExpandido.astro'
import EncaminhamentosIntersetorialidade from '@/components/astro/capitulos/expandidas/EncaminhamentosIntersetorialidade.astro'
import MigracaoProntuarioExpandido from '@/components/astro/capitulos/expandidas/MigracaoProntuarioExpandido.astro'
import PainelEstatisticoExpandido from '@/components/astro/capitulos/expandidas/PainelEstatisticoExpandido.astro'
import CicloAcompanhamento from '@/components/astro/capitulos/expandidas/CicloAcompanhamento.astro'
import TiposRegistro from '@/components/astro/capitulos/expandidas/TiposRegistro.astro'
import FluxoAtendimento from '@/components/astro/capitulos/expandidas/FluxoAtendimento.astro'
import PapelProfissionais from '@/components/astro/capitulos/expandidas/PapelProfissionais.astro'
import RegrasOuroProntuario from '@/components/astro/capitulos/expandidas/RegrasOuroProntuario.astro'
import ResumoPodeNaoPode from '@/components/astro/capitulos/expandidas/ResumoPodeNaoPode.astro'
import ChecklistProntuario from '@/components/astro/capitulos/expandidas/ChecklistProntuario.astro'
import BaseNormativaProntuario from '@/components/astro/capitulos/expandidas/BaseNormativaProntuario.astro'
import SectionHeader from '@/components/astro/layout/SectionHeader.astro'
import SecaoTutorial from '@/components/astro/capitulos/SecaoTutorial.astro'
import SecaoTutorialCarousel from '@/components/astro/capitulos/SecaoTutorialCarousel.astro'

const b = BLOCK_ACCENTS
---

<BaseLayout>
  <Sidebar />
  <ScrollToTop client:idle />
  <BlockAccordion client:idle />
  <WelcomeModal client:load />

  <div id="main-content" data-pagefind-body class="max-w-4xl mx-auto my-8 px-4 md:px-8 space-y-4 md:space-y-6">
    <Capa />
    <Expediente />
    <Sumario />
    <Apresentacao />
    <ProfissionaisPerfis />
    <PapelProfissionais />
    <LoginSistema />
    <TermoUso />

    <div class="flex justify-center no-print">
      <button id="toggle-all-blocks" class="flex items-center gap-2 px-4 py-2 text-sm font-medium bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg shadow-sm hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition-colors max-md:min-h-[44px] max-md:py-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 15 12 9 18 15"/></svg>
        Recolher todos
      </button>
    </div>

    <!-- BLOCO 1: Atendimento Individual e Familiar -->
    <div data-block-group="atendimento-individual">
      <SectionHeader title="Bloco 1 — Atendimento Individual e Familiar" accent="blue" />
      <div data-block-content="atendimento-individual" class="space-y-6">
        <!-- Realizar Atendimento — Carrossel de 5 páginas (17–21) -->
        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl print:shadow-none print:rounded-none border-l-4 ${b.gestao.border} transition-all hover:shadow-lg`}>
          <SecaoTutorialCarousel
            id="realizar-atendimento"
            titulo="Realizar Atendimento"
            descricao="Fluxo completo de acesso ao módulo de atendimento: da seleção da unidade e busca do cadastro até os aspectos globais de registro de observações e regras do sistema."
            observacao="Caso o perfil possua apenas uma unidade de atendimento, a etapa de seleção de unidade não será exibida e o usuário acessará diretamente a busca do cadastro."
            paginas={[
              {
                screenshotSrc: "/assets/screenshots/page-017.webp",
                paginaFisica: 17,
                tituloPagina: "Acesso ao Módulo e Consulta Simples",
                anotacoes: [
                  { numero: 1, texto: 'Menu <strong>Prontuário</strong> — acione para acessar o módulo de atendimento.' },
                  { numero: 2, texto: 'Funcionalidade <strong>Selecionar Unidade</strong> — lista as unidades atribuídas ao usuário conforme perfil no CadSUAS.' },
                  { numero: 3, texto: 'Opção <strong>Pesquisar</strong> — refine a lista de unidades informando os parâmetros desejados.' },
                  { numero: 4, texto: '<strong>Registro na lista</strong> — acione para selecionar a unidade responsável pelo atendimento.' },
                  { numero: 5, texto: 'Opção <strong>Pesquisar</strong> — na Consulta Simples, informe o CPF da pessoa e acione para localizar o cadastro.' },
                ],
                textoExplicativo: "Para iniciar o atendimento, o profissional aciona o menu Prontuário. Caso possua mais de uma unidade vinculada ao perfil, o sistema exibe a tela de seleção onde é possível filtrar por parâmetros e escolher a unidade desejada. Em seguida, na Consulta Simples, basta informar o CPF da pessoa atendida e pesquisar — o sistema localiza o cadastro único automaticamente.",
              },
              {
                screenshotSrc: "/assets/screenshots/page-018.webp",
                paginaFisica: 18,
                tituloPagina: "Consulta Avançada",
                anotacoes: [
                  { numero: 1, texto: 'Campo <strong>Nome</strong> — informe o nome completo da pessoa atendida.' },
                  { numero: 2, texto: 'Campo <strong>Data de Nascimento</strong> — informe a data de nascimento para refinar a busca.' },
                  { numero: 3, texto: 'Campo <strong>Nome da Mãe</strong> — informe o nome da mãe da pessoa atendida.' },
                  { numero: 4, texto: 'Opção <strong>Pesquisar</strong> — acione para localizar o cadastro com os dados informados na consulta avançada.' },
                ],
                textoExplicativo: "Quando o CPF não está disponível, utiliza-se a Consulta Avançada como via alternativa. Preencha os campos de nome, data de nascimento e nome da mãe para localizar o cadastro único da pessoa. Esse recurso garante que nenhum cidadão deixe de ser atendido por falta de documentação, assegurando o acesso universal aos serviços socioassistenciais.",
              },
              {
                screenshotSrc: "/assets/screenshots/page-019.webp",
                paginaFisica: 19,
                tituloPagina: "Registro de Observações — Incluir",
                anotacoes: [
                  { numero: 1, texto: 'Opção <strong>Incluir Observação</strong> — acione para abrir a janela de cadastro de uma nova observação.' },
                  { numero: 2, texto: 'Opção <strong>Visualizar Observação</strong> — exibe os dados da observação em modo leitura.' },
                  { numero: 3, texto: 'Opção <strong>Alterar Observação</strong> — permite editar uma observação existente.' },
                  { numero: 4, texto: 'Opção <strong>Excluir Observação</strong> — remove uma observação após confirmação.' },
                  { numero: 5, texto: 'Opção <strong>Incluir</strong> — salva o registro da observação e atualiza a lista.' },
                ],
                textoExplicativo: "Todos os blocos do Prontuário SUAS permitem o registro de observações textuais. Ao acionar 'Incluir observação', o sistema abre uma janela com os campos Data da Ação e Observação (campo livre para texto). Após preenchimento, a opção 'Incluir' salva o registro, fecha a janela e atualiza a lista de observações com a mensagem de confirmação.",
              },
              {
                screenshotSrc: "/assets/screenshots/page-020.webp",
                paginaFisica: 20,
                tituloPagina: "Registro de Observações — Gerenciar",
                anotacoes: [
                  { numero: 1, texto: 'Opção <strong>Visualizar Observação</strong> — janela com Data da Ação, texto da observação e botão Fechar.' },
                  { numero: 2, texto: 'Opção <strong>Alterar Observação</strong> — habilita os campos para edição; salve com o botão Alterar.' },
                  { numero: 3, texto: 'Opção <strong>Excluir Observação</strong> — remove permanentemente o registro após confirmação.' },
                  { numero: 4, texto: 'Botão <strong>Alterar</strong> — confirma as edições realizadas na observação.' },
                ],
                textoExplicativo: "Para gerenciar observações já registradas: a opção 'Visualizar' exibe os dados em modo somente leitura; 'Alterar' habilita a edição dos campos (confirmada pelo botão Alterar); 'Excluir' remove o registro após confirmação do sistema. Atenção: estas funcionalidades estão disponíveis apenas para a equipe técnica de nível superior e o coordenador do CRAS.",
              },
              {
                screenshotSrc: "/assets/screenshots/page-021.webp",
                paginaFisica: 21,
                tituloPagina: "Aspectos Globais do Módulo",
                anotacoes: [
                  { numero: 1, texto: 'Botão <strong>Expandir Todos</strong> — expande simultaneamente todos os blocos de atendimento; clique novamente para recolher.' },
                  { numero: 2, texto: '<strong>Limite de Caracteres</strong> — campos de observação aceitam até 3.000 caracteres; demais campos abertos, até 2.000.' },
                  { numero: 3, texto: '<strong>Janela Temporal</strong> — inserções e alterações permitidas apenas em até 30 dias após o registro.' },
                  { numero: 4, texto: '<strong>Registro de Pessoa e Família</strong> — benefícios podem ser direcionados à família como um todo ou a um membro específico.' },
                ],
                textoExplicativo: "O módulo Prontuário possui regras globais importantes: os campos de observação aceitam até 3.000 caracteres (recomenda-se fracionar registros muito longos) e os demais campos abertos até 2.000. Inserções e alterações só são permitidas em uma janela de 30 dias — após esse prazo, o sistema bloqueia edições. O botão 'Expandir todos'/'Recolher todos' facilita a navegação visual pelos blocos. Além disso, o sistema distingue benefícios voltados à família (moradia, renda) daqueles destinados a um membro específico (idoso, gestante, pessoa com deficiência).",
              },
            ]}
          />
        </section>

        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl print:shadow-none print:rounded-none border-l-4 ${b.gestao.border} transition-all hover:shadow-lg`}>
          <SecaoTutorial id="informacoes-prontuario" titulo="Informações do Prontuário" screenshotSrc="/assets/screenshots/page-022.webp" paginaFisica={22}
            anotacoes={[
              { numero: 1, texto: 'Campo <strong>Número do Prontuário</strong> — identificador único gerado automaticamente pelo sistema.' },
              { numero: 2, texto: 'Campo <strong>Data de Abertura</strong> — data em que o prontuário foi criado.' },
              { numero: 3, texto: 'Campo <strong>Situação</strong> — informa se o prontuário está Ativo, Inativo ou Excluído.' },
              { numero: 4, texto: 'Campo <strong>Unidade</strong> — unidade de atendimento responsável.' },
              { numero: 5, texto: 'Campo <strong>Nome da Pessoa de Referência</strong> — pessoa de referência familiar.' },
            ]}
          />
        </section>

        <GestaoProntuario />

        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl print:shadow-none print:rounded-none border-l-4 ${b.gestao.border} transition-all hover:shadow-lg`}>
          <SecaoTutorial id="excluir-prontuario" titulo="Excluir Prontuário" screenshotSrc="/assets/screenshots/page-026.webp" paginaFisica={26}
            anotacoes={[
              { numero: 1, texto: 'Opção <strong>Excluir Prontuário</strong> — permite excluir o prontuário do sistema.' },
              { numero: 2, texto: 'Ao acionar, o sistema solicita <strong>confirmação</strong> da ação.' },
              { numero: 3, texto: 'É necessário informar a <strong>justificativa</strong> para a exclusão.' },
            ]}
            observacao="A exclusão do prontuário é irreversível. Certifique-se de que todos os dados foram migrados ou documentados antes de prosseguir."
          />
        </section>

        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl print:shadow-none print:rounded-none border-l-4 ${b.gestao.border} transition-all hover:shadow-lg`}>
          <SecaoTutorialCarousel
            id="identificacao-referencia"
            titulo="Identificação da Pessoa de Referência e Endereço da Família"
            descricao="Dados pessoais, documentos de identificação e endereço completo da família, oriundos do Cadastro Único, exibidos no prontuário para consulta."
            observacao="As informações são apenas para consulta, não sendo possível alterá-las por meio do Prontuário Eletrônico."
            paginas={[
              {
                screenshotSrc: "/assets/screenshots/page-027.webp",
                paginaFisica: 27,
                tituloPagina: "Identificação e Composição Familiar",
                anotacoes: [
                  { numero: 1, texto: 'Agrupamento <strong>Identificação da Pessoa de Referência</strong> — nome, grau de parentesco e dados cadastrais.' },
                  { numero: 2, texto: '<strong>Nome</strong> — campo que informa o nome da pessoa titular do prontuário.' },
                  { numero: 3, texto: '<strong>Grau de Parentesco</strong> — RF, Cônjuge, Filho(a), Enteado(a), Neto(a), Pai/Mãe, Sogro(a), Irmão(ã), Genro/Nora, Outro parente, Não parente.' },
                  { numero: 4, texto: '<strong>Situação Cadastral</strong> e <strong>Data de Nascimento</strong> — informações do Cadastro Único.' },
                  { numero: 5, texto: '<strong>Nome da Mãe</strong> — campo de identificação complementar da pessoa.' },
                ],
                textoExplicativo: "O agrupamento Identificação da pessoa de referência e endereço da família exibe os dados pessoais da pessoa titular do prontuário, incluindo nome, grau de parentesco com a Referência Familiar, situação cadastral, data de nascimento e nome da mãe. Todas as informações são oriundas do Cadastro Único e exibidas apenas para consulta.",
              },
              {
                screenshotSrc: "/assets/screenshots/page-028.webp",
                paginaFisica: 28,
                tituloPagina: "Dados Pessoais",
                anotacoes: [
                  { numero: 1, texto: 'Funcionalidade <strong>Dados Pessoais</strong> — CPF, NIS e documentos de identificação da pessoa.' },
                  { numero: 2, texto: '<strong>CPF</strong> — com ícone <strong>Copiar</strong> para facilitar o registro.' },
                  { numero: 3, texto: '<strong>NIS</strong> — Número de Identificação Social da pessoa.' },
                  { numero: 4, texto: '<strong>RG</strong>, <strong>Data de Emissão</strong>, <strong>Órgão</strong> e <strong>UF</strong> — dados completos do Registro Geral.' },
                ],
                textoExplicativo: "A seção Dados Pessoais concentra os documentos de identificação da pessoa: CPF (com opção de cópia rápida), NIS, RG, data de emissão, órgão expedidor e UF. Esses dados são fundamentais para a correta identificação do usuário nos sistemas da Rede SUAS.",
              },
              {
                screenshotSrc: "/assets/screenshots/page-029.webp",
                paginaFisica: 29,
                tituloPagina: "Dados do Endereço",
                anotacoes: [
                  { numero: 1, texto: 'Funcionalidade <strong>Dados do Endereço</strong> — endereço completo da residência familiar.' },
                  { numero: 2, texto: '<strong>Endereço</strong>, <strong>Bairro</strong>, <strong>CEP</strong> e <strong>Município/UF</strong> — localização da residência.' },
                  { numero: 3, texto: '<strong>Ponto de Referência</strong> — informação complementar de localização.' },
                  { numero: 4, texto: '<strong>Localização do Domicílio</strong> — indica se a residência está em área urbana ou rural.' },
                  { numero: 5, texto: '<strong>Abrigo</strong> e <strong>Tipo</strong> — informações sobre a natureza do domicílio.' },
                ],
                textoExplicativo: "A seção Dados do Endereço apresenta a localização completa da residência da família, incluindo endereço, bairro, CEP, município, ponto de referência, tipo de localização (urbana ou rural) e informações sobre abrigo. Estas informações são provenientes do Cadastro Único e exibidas apenas para consulta no Prontuário Eletrônico.",
              },
            ]}
          />
        </section>

        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl print:shadow-none print:rounded-none border-l-4 ${b.gestao.border} transition-all hover:shadow-lg`}>
          <SecaoTutorial id="informacoes-familia" titulo="Informações da Família" screenshotSrc="/assets/screenshots/page-030.webp" paginaFisica={30}
            anotacoes={[
              { numero: 7, texto: 'Agrupamento <strong>Informações da Família</strong> — dados cadastrais do Cadastro Único.' },
              { numero: 8, texto: '<strong>Código Familiar</strong> — código do cadastro no Cadastro Único.' },
              { numero: 9, texto: '<strong>Data de Atualização</strong> — última atualização do Cadastro Único.' },
              { numero: 10, texto: '<strong>Renda Per Capita</strong> — renda média da família.' },
              { numero: 11, texto: '<strong>Estado Cadastral</strong> — situação do cadastro.' },
              { numero: 12, texto: '<strong>Recebe Bolsa Família</strong> — indica se é beneficiário.' },
            ]}
            observacao="As informações são apenas para consulta, não sendo possível alterá-las pelo Prontuário Eletrônico."
          />
        </section>

        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl print:shadow-none print:rounded-none border-l-4 ${b.gestao.border} transition-all hover:shadow-lg`}>
          <SecaoTutorialCarousel
            id="composicao-familiar"
            titulo="Composição Familiar"
            descricao="Consulta ao perfil etário do grupo familiar e às especificidades sociais, étnicas e culturais da família registradas no Cadastro Único."
            paginas={[
              {
                screenshotSrc: "/assets/screenshots/page-040.webp",
                paginaFisica: 40,
                tituloPagina: "Perfil Etário e Especificidades",
                anotacoes: [
                  { numero: 1, texto: 'Bloco <strong>Composição Familiar</strong> — perfil etário do grupo familiar, especificidades sociais, étnicas e culturais.' },
                  { numero: 2, texto: '<strong>Perfil etário do grupo familiar</strong> — quantidade de pessoas por faixa etária e total da família.' },
                  { numero: 3, texto: '<strong>Especificidades sociais, étnicas ou culturais</strong> — Família indígena, quilombola, grupos tradicionais, situação de rua.' },
                  { numero: 4, texto: 'Campos <strong>Família indígena</strong>, <strong>Povo indígena</strong>, <strong>Terra/reserva indígena</strong> — identificação étnica.' },
                ],
                textoExplicativo: "O bloco Composição Familiar apresenta duas seções principais: o perfil etário, que mostra a distribuição dos membros por faixa etária, e as especificidades sociais, étnicas e culturais, que identificam se a família pertence a povos indígenas, comunidades quilombolas, grupos tradicionais ou se encontra em situação de rua.",
              },
              {
                screenshotSrc: "/assets/screenshots/page-041.webp",
                paginaFisica: 41,
                tituloPagina: "Observações da Composição Familiar",
                anotacoes: [
                  { numero: 1, texto: 'Seção <strong>Observações da composição familiar</strong> — campo para registro de informações complementares.' },
                  { numero: 2, texto: 'Ícone para <strong>retrair ou reexibir</strong> as informações do bloco.' },
                  { numero: 3, texto: 'Para mais informações, consulte a página 19 sobre registro de observações.' },
                ],
                textoExplicativo: "A seção de observações permite que o profissional registre informações complementares sobre a composição familiar. Utilize o ícone de expandir/recolher para controlar a visualização do bloco.",
              },
            ]}
          />
        </section>

        <section class={`bg-white dark:bg-slate-800 shadow-md rounded-xl print:shadow-none print:rounded-none border-l-4 ${b.gestao.border} transition-all hover:shadow-lg`}>
          <SecaoTutorialCarousel
            id="forma-ingresso"
            titulo="Forma de Ingresso e Motivo do Atendimento"
            descricao="Fluxo completo de registro da forma de ingresso da pessoa/família na unidade CRAS: cadastro, visualização, edição e exclusão dos registros de primeiro atendimento."
            observacao="O registro da forma de ingresso subsidia o planejamento do trabalho social e permite identificar as principais portas de entrada da população no CRAS."
            paginas={[
              {
                screenshotSrc: "/assets/screenshots/page-032.webp",
                paginaFisica: 32,
                tituloPagina: "Lista de Registros de Ingresso",
                anotacoes: [
                  { numero: 1, texto: 'Bloco <strong>Forma de Ingresso</strong> — forma de acesso da pessoa na unidade CRAS.' },
                  { numero: 2, texto: '<strong>Data da Ação</strong> — coluna com a data em que a pessoa buscou atendimento.' },
                  { numero: 3, texto: '<strong>Forma de Ingresso</strong> — coluna com a forma como a pessoa acessou a unidade.' },
                  { numero: 4, texto: '<strong>Unidade</strong> — nome da unidade onde o atendimento foi realizado.' },
                  { numero: 5, texto: 'Coluna <strong>Ações</strong> — ícone para visualizar o registro completo.' },
                ],
                textoExplicativo: "O bloco Forma de Ingresso apresenta a lista de registros de como a pessoa/família acessou a unidade CRAS. Cada registro contém a data da ação, a forma de ingresso, a unidade de atendimento e ações disponíveis. É o ponto de partida para registrar, visualizar, alterar ou excluir formas de ingresso.",
              },
              {
                screenshotSrc: "/assets/screenshots/page-033.webp",
                paginaFisica: 33,
                tituloPagina: "Incluir Forma de Ingresso",
                anotacoes: [
                  { numero: 1, texto: 'Opção <strong>Incluir Forma de Ingresso</strong> — acione para adicionar um novo registro.' },
                  { numero: 2, texto: '<strong>Pessoa(s)</strong> — campo com o(s) nome(s) da(s) pessoa(s) atendida(s).' },
                  { numero: 3, texto: '<strong>Data do Atendimento</strong> e <strong>N.º do Prontuário Físico</strong> — informações do registro.' },
                  { numero: 4, texto: '<strong>Forma de acesso</strong> — campo para selecionar como a família acessou a unidade.' },
                  { numero: 5, texto: '<strong>Razões que motivaram</strong> — informações adicionais sobre o primeiro atendimento.' },
                  { numero: 6, texto: 'Opção <strong>Incluir</strong> — salva o registro e atualiza a lista.' },
                ],
                textoExplicativo: "Para adicionar um novo registro de forma de ingresso, o profissional aciona 'Incluir forma de ingresso' e preenche os campos: pessoa(s) atendida(s), data do atendimento, número do prontuário físico, forma de acesso à unidade e razões que motivaram o primeiro atendimento. A opção 'Incluir' salva e atualiza a lista com a mensagem de confirmação.",
              },
