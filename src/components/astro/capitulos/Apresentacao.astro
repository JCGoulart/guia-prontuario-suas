---
// Apresentação e Conceitos Gerais do Manual
import FeatureCard from '@/components/astro/content/FeatureCard.astro'
import ConceitosFlowModal from '@/components/react/content/ConceitosFlowModal'
---

<section id="apresentacao" class="animate-fade-in bg-white dark:bg-slate-800 shadow-xl rounded-2xl p-8 md:p-16 print:shadow-none print:rounded-none print:break-before-page">
  <div class="flex items-center gap-3 mb-3">
    <div class="w-10 h-10 rounded-xl bg-institucional-green flex items-center justify-center shadow-md shadow-institucional-green/25">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
    </div>
    <h2 class="text-3xl md:text-4xl font-extrabold text-slate-800 dark:text-white tracking-tight">Apresentação</h2>
  </div>

  <div class="h-1 w-20 rounded-full bg-gradient-to-r from-institucional-green to-green-300 mb-8" />

  <div class="prose max-w-none text-slate-600 dark:text-slate-400 space-y-4 text-base leading-relaxed">
    <p class="text-lg">O <strong class="text-slate-800 dark:text-white">Prontuário Eletrônico do SUAS</strong> é a versão digital do prontuário utilizado no atendimento socioassistencial. Ele registra os atendimentos de forma organizada e sintética, centralizando informações para apoiar o trabalho das equipes e a gestão das unidades.</p>
    <p>Mantém a estrutura do formulário físico, com recursos adicionais que garantem mais segurança, agilidade e continuidade no acompanhamento das famílias.</p>
  </div>

  <!-- Estrutura do Sistema -->
  <div class="mt-10">
    <div class="border-l-4 border-institucional-green bg-gradient-to-br from-green-50 to-green-100/60 dark:from-green-950/40 dark:to-green-900/20 rounded-r-xl pl-5 py-3 mb-8">
      <h3 class="text-xl font-bold text-slate-800 dark:text-white">Estrutura do Sistema</h3>
      <p class="text-sm text-slate-600 dark:text-slate-400 mt-2 italic leading-relaxed">
        O Prontuário Eletrônico é o espaço onde a unidade registra, de forma simples e sintética, todos os atendimentos realizados com a família que procura o serviço.
      </p>
    </div>

    <!-- Sigilo das Informações -->
    <div class="border-l-4 border-amber-500 bg-gradient-to-br from-amber-50 to-amber-100/60 dark:from-amber-950/40 dark:to-amber-900/20 rounded-r-xl pl-5 py-3 mb-8 mt-6">
      <h3 class="text-xl font-bold text-slate-800 dark:text-white">Sigilo das Informações</h3>
      <p class="text-sm text-slate-600 dark:text-slate-400 mt-2 italic leading-relaxed">
        Todas as informações registradas no Prontuário Eletrônico do SUAS são protegidas por sigilo profissional e pela Lei Geral de Proteção de Dados (LGPD — Lei nº 13.709/2018). O acesso aos dados é restrito aos profissionais autorizados, conforme os perfis definidos no CadSUAS, e qualquer compartilhamento indevido constitui violação ética e legal.
      </p>
    </div>
    <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-8 text-sm">
      Por meio do prontuário, é possível visualizar rapidamente o histórico da família, registrar novas ações e apoiar decisões de forma segura e integrada. Além disso, todos os blocos do prontuário possuem campos de observação onde o profissional pode escrever as anotações que considerar pertinentes, trazendo flexibilidade ao sistema para o trabalho social realizado no CRAS.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
      <FeatureCard
        title="Atendimento à Família"
        description="Registro do atendimento individualizado e familiar, com escuta qualificada, diagnóstico social, plano de acompanhamento e evolução no prontuário de cada família."
        accent="blue"
        icon="Users"
        badge="Individual"
      />
      <FeatureCard
        title="Atendimento Coletivo"
        description="Registro único de atividades coletivas com listagem de CPF, inserido automaticamente no prontuário de cada participante."
        accent="green"
        icon="LayoutGrid"
        badge="Grupo"
      />
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <FeatureCard
        title="Migrar Prontuário"
        description="Gerencia transferências de prontuários entre unidades, mantendo a continuidade do acompanhamento quando famílias mudam de CRAS."
        accent="blue"
        icon="Users"
        badge="Transferência"
      />
      <FeatureCard
        title="Painel Estatístico"
        description="Visão agregada dos atendimentos com indicadores e filtros para acompanhar volume, perfil e evolução das ações."
        accent="purple"
        icon="BarChart3"
        badge="Indicadores"
      />
    </div>
  </div>
</section>

<!-- Conceitos Gerais -->
<section id="conceitos-gerais" class="animate-fade-in bg-white dark:bg-slate-800 shadow-xl rounded-2xl p-8 md:p-16 print:shadow-none print:rounded-none mt-6">
  <div class="flex items-center gap-3 mb-3">
    <div class="w-10 h-10 rounded-xl bg-institucional-blue flex items-center justify-center shadow-md shadow-institucional-blue/25">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    </div>
    <h2 class="text-3xl md:text-4xl font-extrabold text-slate-800 dark:text-white tracking-tight">Conceitos Gerais</h2>
  </div>

  <div class="h-1 w-20 rounded-full bg-gradient-to-r from-institucional-blue to-blue-300 mb-8" />

  <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
    Neste tópico você conhecerá conceitos importantes que auxiliarão na operação do Sistema Prontuário Eletrônico SUAS e na gestão dos dados nele inseridos e armazenados.
  </p>

  <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
    Os conceitos abordados incluem <strong>Família</strong>, <strong>Território</strong>, <strong>Atendimento</strong>, <strong>Acompanhamento Social</strong>, <strong>Articulação Intersetorial</strong>, <strong>Busca Ativa</strong>, <strong>Diagnóstico Social</strong>, <strong>Escuta Qualificada</strong> e <strong>Prática Reflexiva</strong> — cada um com definição e exemplos práticos do dia a dia no SUAS.
  </p>

  <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-8">
    <strong>Clique no botão abaixo</strong> para explorar todos os conceitos com suas descrições completas e exemplos práticos.
  </p>

  <!-- Botão para abrir diagrama interativo -->
  <div class="flex justify-center my-8">
    <button
      onclick="window.openConceitosFlowModal?.()"
      class="inline-flex items-center gap-3 px-6 py-4 rounded-2xl text-sm font-semibold bg-gradient-to-br from-white to-slate-50 dark:from-slate-800 dark:to-slate-800/60 border-2 border-dashed border-slate-300 dark:border-slate-600 shadow-sm hover:shadow-lg hover:border-institucional-blue dark:hover:border-institucional-blue hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200 group"
    >
      <span class="w-12 h-12 rounded-xl flex items-center justify-center bg-gradient-to-br from-institucional-blue to-institucional-blue/80 text-white shadow-md group-hover:scale-110 transition-transform duration-200">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </span>
      <div class="text-left">
        <span class="block text-slate-800 dark:text-slate-100 group-hover:text-institucional-blue transition-colors">Explorar conceitos</span>
        <span class="block text-xs text-slate-500 dark:text-slate-400 mt-0.5">10 conceitos fundamentais para o Prontuário SUAS</span>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 group-hover:text-institucional-blue group-hover:translate-x-0.5 transition-all"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>

  <ConceitosFlowModal client:load />
</section>
