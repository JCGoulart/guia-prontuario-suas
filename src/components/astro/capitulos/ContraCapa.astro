<section id="contra-capa" class="animate-scale bg-white dark:bg-slate-800 shadow-xl rounded-2xl overflow-hidden print:shadow-none print:rounded-none">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 1600" preserveAspectRatio="xMidYMid meet"><title>Contra-Capa — Guia do Prontuário Eletrônico</title>
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#004b87"/>
