---
import SectionHeader from '@/components/astro/layout/SectionHeader.astro'

const roles = [
  {
    title: 'Coordenador',
    description: 'Supervisiona a qualidade dos registros e aprova relatórios.',
    detail: 'Supervisiona a qualidade dos registros e aprova relatórios. Responsável pela gestão da unidade e consolidação dos dados para prestação de contas.',
    variant: 'coordenador',
  },
  {
    title: 'Técnico de Referência',
    description: 'Realiza entrevistas e preenche diagnósticos.',
    detail: 'Realiza entrevistas, preenche diagnósticos, elabora e monitora o plano de acompanhamento familiar. É o principal responsável pelo conteúdo do prontuário.',
    variant: 'tecnico',
  },
  {
    title: 'Administrativo',
    description: 'Gerencia abertura de prontuários.',
    detail: 'Gerencia a abertura de prontuários, confere dados cadastrais e apoia a organização documental. Pode visualizar mas não editar campos técnicos.',
    variant: 'administrativo',
  },
  {
    title: 'Digitador',
    description: 'Insere dados do CadÚnico.',
    detail: 'Insere dados do CadÚnico e atualiza informações cadastrais. Não realiza análises técnicas nem registros de evolução.',
    variant: 'digitador',
  },
  {
    title: 'Conselho (CMAS)',
    description: 'Acompanha e fiscaliza recursos.',
    detail: 'Acompanha e fiscaliza a aplicação dos recursos. Pode solicitar relatórios agregados do Painel Estatístico, sem acesso a dados individuais.',
    variant: 'conselho',
  },
]

const variantStyles: Record<string, { bg: string; border: string; icon: string; title: string }> = {
  coordenador: {
    bg: 'from-blue-50 to-white dark:from-blue-950/40 dark:to-slate-800',
    border: 'border-blue-500 dark:border-blue-500',
    icon: 'from-blue-500 to-blue-400',
    title: 'text-blue-700 dark:text-blue-300',
  },
  tecnico: {
    bg: 'from-amber-50 to-white dark:from-amber-950/40 dark:to-slate-800',
    border: 'border-amber-500 dark:border-amber-400',
    icon: 'from-amber-500 to-amber-400',
    title: 'text-amber-700 dark:text-amber-300',
  },
  administrativo: {
    bg: 'from-slate-50 to-white dark:from-slate-800/60 dark:to-slate-800',
    border: 'border-slate-400 dark:border-slate-500',
    icon: 'from-slate-500 to-slate-400',
    title: 'text-slate-700 dark:text-slate-300',
  },
  digitador: {
    bg: 'from-green-50 to-white dark:from-green-950/40 dark:to-slate-800',
    border: 'border-green-500 dark:border-green-400',
    icon: 'from-green-500 to-green-400',
    title: 'text-green-700 dark:text-green-300',
  },
  conselho: {
    bg: 'from-purple-50 to-white dark:from-purple-950/40 dark:to-slate-800',
    border: 'border-purple-500 dark:border-purple-400',
    icon: 'from-purple-500 to-purple-400',
    title: 'text-purple-700 dark:text-purple-300',
  },
}

const iconsMap: Record<string, string> = {
  coordenador:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>',
  tecnico:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>',
  administrativo:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>',
  digitador:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>',
  conselho:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>',
}
---

<section
  id="papel-profissionais"
  class="animate-fade-in bg-white dark:bg-slate-800 shadow-xl rounded-2xl p-8 md:p-16 mt-6"
>
  <SectionHeader title="Papel de Cada Profissional no Prontuário" accent="blue" />

  <div class="prose max-w-none text-slate-700 dark:text-slate-300 space-y-4 mb-8">
    <p>
      O Prontuário Eletrônico do SUAS é uma ferramenta compartilhada por diferentes perfis profissionais, cada um com atribuições e permissões específicas. A definição clara desses papéis garante a integridade dos dados, a segurança da informação e a eficiência do trabalho em rede.
    </p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
    {roles.map((role) => {
      const vs = variantStyles[role.variant]
      return (
        <div
          class={`flex flex-col items-center text-center p-4 rounded-xl border-2 bg-gradient-to-br shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 h-full ${vs.bg} ${vs.border}`}
        >
          <div
            class={`w-10 h-10 rounded-xl flex items-center justify-center text-white bg-gradient-to-br shrink-0 mb-3 ${vs.icon}`}
            set:html={iconsMap[role.variant]}
          />
          <span class={`font-bold text-sm leading-tight ${vs.title}`}>{role.title}</span>
          <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1 leading-tight font-medium">
            {role.description}
          </p>
          <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-2 leading-relaxed hidden md:block">
            {role.detail}
          </p>
        </div>
      )
    })}
  </div>
</section>
