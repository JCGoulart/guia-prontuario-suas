---
// Metodologia do Acompanhamento Familiar — seção expandida com conceitos, timeline e boas práticas
import type { Anotacao } from '@/types'
import SecaoTutorial from '@/components/astro/capitulos/SecaoTutorial.astro'
import SectionHeader from '@/components/astro/layout/SectionHeader.astro'
import ProcessStepper from '@/components/astro/content/ProcessStepper.astro'
import BestPracticesList from '@/components/astro/content/BestPracticesList.astro'

const anotacoes: Anotacao[] = [
  { numero: 1, texto: 'Janela <strong>Incluir acompanhamento familiar</strong> — formulário para iniciar ou editar o acompanhamento sistemático da família.' },
  { numero: 2, texto: '<strong>Data do ingresso</strong> — indica a data em que a composição familiar foi incluída no acompanhamento.' },
  { numero: 3, texto: '<strong>Planejamento inicial</strong> — registra como o técnico pretende organizar e acompanhar as ações planejadas para o atendimento da família, definindo os passos e estratégias que orientarão o acompanhamento.' },
  { numero: 4, texto: '<strong>Data do desligamento</strong> — indica a data em que a família foi desvinculada do acompanhamento.' },
  { numero: 5, texto: '<strong>Razão do desligamento</strong> — indica o motivo. Valores: Avaliação técnica, Evasão ou recusa da família, Mudança de Município, Outros.' },
  { numero: 6, texto: 'Lista de acompanhamentos ativos — exibe Data de Ingresso, Data de Desligamento e Razão do desligamento.' },
  { numero: 7, texto: 'Acione <strong>Incluir</strong> para salvar o registro e atualizar a lista de acompanhamentos.' },
]

const acompanhamentoSteps = [
  { number: 1, title: 'Ingresso', description: 'A família é inserida no acompanhamento sistemático pelo técnico de referência do CRAS, com registro da data de ingresso e planejamento inicial.', accent: 'blue' as const },
  { number: 2, title: 'Diagnóstico', description: 'Levantamento das vulnerabilidades, potencialidades e demandas da família, fundamentando as decisões técnicas subsequentes.', accent: 'blue' as const },
  { number: 3, title: 'Plano de Acompanhamento', description: 'Definição estruturada de objetivos, ações e prazos que orientarão o trabalho social com a família.', accent: 'green' as const },
  { number: 4, title: 'Evoluções Periódicas', description: 'Registros contínuos das interações, avanços, encaminhamentos e percepções técnicas a cada contato com a família.', accent: 'green' as const },
  { number: 5, title: 'Reavaliação', description: 'Análise crítica dos resultados alcançados e eventuais ajustes no plano de acompanhamento.', accent: 'slate' as const },
  { number: 6, title: 'Desligamento', description: 'Encerramento do ciclo quando os objetivos são atingidos ou por critérios técnicos como evasão, mudança de município ou outros motivos justificados.', accent: 'slate' as const },
]
---

<section
  id="metodologia-acompanhamento"
  class="animate-fade-in bg-white dark:bg-slate-800 shadow-xl rounded-2xl p-8 md:p-16 print:shadow-none print:rounded-none"
>
  <SectionHeader title="Metodologia do Acompanhamento Familiar" accent="blue" />

  <!-- Prosa conceitual — 4 blocos temáticos -->
  <div class="space-y-5 mb-10">
    <!-- Bloco 1: Processo Sistemático -->
    <div class="border-l-4 border-institucional-blue bg-gradient-to-br from-blue-50 to-blue-100/60 dark:from-blue-950/40 dark:to-blue-900/20 rounded-r-xl pl-5 py-4 pr-4">
      <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-2 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-institucional-blue"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Processo Sistemático e Planejado
      </h3>
      <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        O <strong class="text-slate-800 dark:text-white">acompanhamento familiar</strong> no âmbito do PAIF — Serviço de Proteção e
        Atendimento Integral à Família — não se reduz a visitas domiciliares ou contatos pontuais. Trata-se de um
        <strong class="text-slate-800 dark:text-white">processo sistemático e planejado</strong>, conduzido pela equipe de
        referência do CRAS, que estabelece objetivos claros, ações estruturadas e instrumentos de avaliação contínua
        para apoiar as famílias na superação de vulnerabilidades e no fortalecimento de vínculos.
      </p>
    </div>

    <!-- Bloco 2: Tripé Metodológico -->
    <div class="border-l-4 border-institucional-green bg-gradient-to-br from-green-50 to-green-100/60 dark:from-green-950/40 dark:to-green-900/20 rounded-r-xl pl-5 py-4 pr-4">
      <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-2 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-institucional-green"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        O Tripé: Objetivos, Ações e Prazos
      </h3>
      <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        Estruturar um plano de acompanhamento significa articular três dimensões interdependentes:
        <strong class="text-slate-800 dark:text-white">objetivos</strong> (o que se pretende alcançar com a família),
        <strong class="text-slate-800 dark:text-white">ações</strong> (as estratégias e atividades que serão desenvolvidas
        em cada etapa) e <strong class="text-slate-800 dark:text-white">prazos</strong> (os marcos temporais para
        reavaliação dos resultados). Esse tripé garante intencionalidade ao trabalho social e impede que o
        acompanhamento se torne uma sucessão desconexa de atendimentos.
      </p>
    </div>

    <!-- Bloco 3: Papel do Técnico -->
    <div class="border-l-4 border-amber-500 bg-gradient-to-br from-amber-50 to-amber-100/60 dark:from-amber-950/40 dark:to-amber-900/20 rounded-r-xl pl-5 py-4 pr-4">
      <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-2 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        O Técnico de Referência e as Evoluções
      </h3>
      <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        O <strong class="text-slate-800 dark:text-white">técnico de referência</strong> desempenha papel central: é dele a
        responsabilidade de manter contato regular com a família, registrar as
        <strong class="text-slate-800 dark:text-white">evoluções</strong> — descrições do que foi observado, dialogado e
        encaminhado a cada interação — e ajustar o plano conforme as circunstâncias se modificam. As evoluções são o
        fio condutor que documenta a trajetória da família, permitindo que qualquer profissional que acesse o prontuário
        compreenda o percurso já trilhado e as decisões tomadas.
      </p>
    </div>

    <!-- Bloco 4: Desligamento e Continuidade -->
    <div class="border-l-4 border-purple-500 bg-gradient-to-br from-purple-50 to-purple-100/60 dark:from-purple-950/40 dark:to-purple-900/20 rounded-r-xl pl-5 py-4 pr-4">
      <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-2 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple-500"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
        Desligamento e Continuidade do Cuidado
      </h3>
      <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        O <strong class="text-slate-800 dark:text-white">desligamento</strong> não deve ser confundido com abandono. Os
        critérios são bem definidos: <strong class="text-slate-800 dark:text-white">avaliação técnica</strong> concluindo
        que os objetivos foram alcançados; <strong class="text-slate-800 dark:text-white">evasão ou recusa</strong> da
        família; <strong class="text-slate-800 dark:text-white">mudança de município</strong>, exigindo migração do
        prontuário; ou <strong class="text-slate-800 dark:text-white">outros</strong> motivos justificados. Registrar
        evoluções com regularidade transforma o prontuário em um
        <strong class="text-slate-800 dark:text-white">instrumento vivo de gestão do cuidado</strong>, construindo uma
        memória técnica que fundamenta decisões e protege tanto a família quanto o profissional.
      </p>
    </div>
  </div>

  <!-- Screenshot com anotações -->
  <SecaoTutorial
    screenshotSrc="/assets/screenshots/page-086.webp"
    titulo="Planejamento e Evolução do Acompanhamento"
    paginaFisica={86}
    anotacoes={anotacoes}
  />

  <!-- Timeline do acompanhamento familiar -->
  <ProcessStepper steps={acompanhamentoSteps} class="mt-10" />

  <!-- Boas práticas -->
  <div class="mt-10">
    <BestPracticesList
      title="Boas Práticas no Acompanhamento Familiar"
      items={[
        "Estabeleça uma frequência mínima de contato com cada família em acompanhamento — seja presencial, domiciliar ou remoto. A regularidade constrói vínculo e permite observar mudanças ao longo do tempo.",
        "As evoluções devem ir além de 'família atendida'. Registre o que foi observado, as demandas apresentadas, os encaminhamentos realizados e as percepções técnicas.",
        "O desligamento deve ser uma decisão técnica fundamentada, registrada no prontuário com justificativa clara. Antes de desligar, avalie se os objetivos do plano foram atingidos.",
      ]}
      accent="green"
    />
  </div>

  </section>
