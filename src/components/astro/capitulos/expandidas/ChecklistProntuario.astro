---
import { checklistProntuario } from '@/data/checklist'
import ChecklistGrid from '@/components/react/content/ChecklistGrid'
import SectionHeader from '@/components/astro/layout/SectionHeader.astro'
import AlertBox from '@/components/astro/content/AlertBox.astro'
---

<section
  id="checklist-prontuario"
  class="animate-fade-in bg-white dark:bg-slate-800 shadow-xl rounded-2xl p-8 md:p-16 mt-6"
>
  <SectionHeader
    title="Checklist: Antes de Registrar no Prontuário"
    accent="blue"
  />

  <AlertBox variant="warning">
    O profissional deve verificar todos os itens antes de iniciar o registro no
    prontuário eletrônico:
  </AlertBox>

  <div class="mt-6">
    <ChecklistGrid client:load items={checklistProntuario}>
      <div slot="fallback" class="space-y-3">
        <div class="animate-pulse bg-white dark:bg-slate-800 p-3 rounded shadow-sm border h-12"></div>
        <div class="animate-pulse bg-white dark:bg-slate-800 p-3 rounded shadow-sm border h-12"></div>
      </div>
    </ChecklistGrid>
  </div>

  <div class="mt-6">
    <AlertBox variant="info">
      Os recursos são repassados do FEAS para os FMAS. O CMAS não recebe o
      recurso: ele aprova, fiscaliza e controla.
    </AlertBox>
  </div>
</section>
