---
import SectionHeader from '@/components/astro/layout/SectionHeader.astro'
import AlertBox from '@/components/astro/content/AlertBox.astro'

const steps = [
  { number: 1, title: 'Abertura', description: 'Identificação e acolhida da família no serviço, com registro inicial no sistema.', variant: 'abertura' },
  { number: 2, title: 'Diagnóstico', description: 'Levantamento das vulnerabilidades, riscos e potencialidades da família.', variant: 'diagnostico' },
  { number: 3, title: 'Plano', description: 'Elaboração do Plano de Acompanhamento Familiar com objetivos e metas.', variant: 'plano' },
  { number: 4, title: 'Registro', description: 'Registro sistemático dos atendimentos e intervenções realizadas.', variant: 'registro' },
  { number: 5, title: 'Evolução', description: 'Acompanhamento da evolução da família frente aos objetivos traçados.', variant: 'evolucao' },
  { number: 6, title: 'Revisão', description: 'Reavaliação periódica do plano e ajustes conforme necessidades.', variant: 'revisao' },
]

const stepVariantStyles = {
  abertura: {
    card: 'from-purple-50 to-white dark:from-purple-950/40 dark:to-slate-800 border-purple-500 dark:border-purple-500',
    icon: 'from-purple-500 to-purple-400',
    title: 'text-purple-700 dark:text-purple-300',
    number: 'text-purple-500 dark:text-purple-400',
  },
  diagnostico: {
    card: 'from-blue-50 to-white dark:from-blue-950/40 dark:to-slate-800 border-blue-500 dark:border-blue-500',
    icon: 'from-blue-500 to-blue-400',
    title: 'text-blue-700 dark:text-blue-300',
    number: 'text-blue-500 dark:text-blue-400',
  },
  plano: {
    card: 'from-cyan-50 to-white dark:from-cyan-950/40 dark:to-slate-800 border-cyan-500 dark:border-cyan-500',
    icon: 'from-cyan-500 to-cyan-400',
    title: 'text-cyan-700 dark:text-cyan-300',
    number: 'text-cyan-500 dark:text-cyan-400',
  },
  registro: {
    card: 'from-green-50 to-white dark:from-green-950/40 dark:to-slate-800 border-green-500 dark:border-green-500',
    icon: 'from-green-500 to-green-400',
    title: 'text-green-700 dark:text-green-300',
    number: 'text-green-500 dark:text-green-400',
  },
  evolucao: {
    card: 'from-orange-50 to-white dark:from-orange-950/40 dark:to-slate-800 border-orange-500 dark:border-orange-500',
    icon: 'from-orange-500 to-orange-400',
    title: 'text-orange-700 dark:text-orange-300',
    number: 'text-orange-500 dark:text-orange-400',
  },
  revisao: {
    card: 'from-indigo-50 to-white dark:from-indigo-950/40 dark:to-slate-800 border-indigo-500 dark:border-indigo-500',
    icon: 'from-indigo-500 to-indigo-400',
    title: 'text-indigo-700 dark:text-indigo-300',
    number: 'text-indigo-500 dark:text-indigo-400',
  },
}

const icons: Record<string, string> = {
  abertura:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>',
  diagnostico:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>',
  plano:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>',
  registro:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>',
  evolucao:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>',
  revisao:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>',
}
---

<section id="ciclo-acompanhamento" class="animate-fade-in bg-white dark:bg-slate-800 shadow-xl rounded-2xl p-8 md:p-16 mt-6">
  <SectionHeader title="Ciclo do Acompanhamento Familiar" accent="blue" />

  <div class="prose prose-slate dark:prose-invert max-w-none mt-4 mb-8">
    <p>
      O acompanhamento familiar no SUAS segue um ciclo contínuo e estruturado,
      organizado em seis etapas interdependentes. Esse processo garante que cada
      família receba atenção integral, desde a acolhida inicial até a revisão
      periódica das ações, permitindo ajustes conforme a evolução do caso e as
      necessidades identificadas.
    </p>
  </div>

  <div class="flex flex-col gap-6 md:gap-8 bg-gradient-to-br from-slate-50 to-white dark:from-slate-900 dark:to-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 px-6 py-8 md:p-8">
    <!-- Linha 1: 01, 02, 03 -->
    <div class="flex flex-col md:flex-row items-center justify-center gap-0 w-full">
      {steps.slice(0, 3).map((step, index) => {
        const vs = stepVariantStyles[step.variant as keyof typeof stepVariantStyles]
        return (
        <>
          <div
            class={`flex flex-col items-center text-center p-6 rounded-xl border-2 bg-gradient-to-br shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all w-full max-w-[320px] md:flex-1 md:min-w-0 md:max-w-[300px] relative animate-slide-down ${vs.card}`}
            style={`--delay: ${index * 100}ms`}
          >
            <div class={`w-12 h-12 rounded-xl flex items-center justify-center text-white mb-3 bg-gradient-to-br ${vs.icon}`} set:html={icons[step.variant]} />
            <span class={`text-[10px] font-extrabold tracking-[0.1em] opacity-50 mb-1 font-mono ${vs.number}`}>{String(step.number).padStart(2, '0')}</span>
            <h4 class={`text-[0.8125rem] font-bold leading-tight mb-1.5 ${vs.title}`}>{step.title}</h4>
            <p class="text-[0.6875rem] leading-relaxed text-slate-500 dark:text-slate-400 m-0">{step.description}</p>
          </div>
          {index < 2 && (
            <div class="h-8 md:w-8 md:h-auto flex items-center justify-center shrink-0 animate-slide-down" style={`--delay: ${index * 100 + 60}ms`}>
              <svg class="w-6 h-6 text-slate-400 dark:text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path class="chevron-desktop" d="M9 18l6-6-6-6" />
                <path class="chevron-mobile" d="M6 9l6 6 6-6" />
              </svg>
            </div>
          )}
        </>
        )
      })}
    </div>

    <!-- Linha 2: 04, 05, 06 -->
    <div class="flex flex-col md:flex-row items-center justify-center gap-0 w-full">
      {steps.slice(3, 6).map((step, index) => {
        const vs = stepVariantStyles[step.variant as keyof typeof stepVariantStyles]
        return (
        <>
          <div
            class={`flex flex-col items-center text-center p-6 rounded-xl border-2 bg-gradient-to-br shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all w-full max-w-[320px] md:flex-1 md:min-w-0 md:max-w-[300px] relative animate-slide-down ${vs.card}`}
            style={`--delay: ${(index + 3) * 100}ms`}
          >
            <div class={`w-12 h-12 rounded-xl flex items-center justify-center text-white mb-3 bg-gradient-to-br ${vs.icon}`} set:html={icons[step.variant]} />
            <span class={`text-[10px] font-extrabold tracking-[0.1em] opacity-50 mb-1 font-mono ${vs.number}`}>{String(step.number).padStart(2, '0')}</span>
            <h4 class={`text-[0.8125rem] font-bold leading-tight mb-1.5 ${vs.title}`}>{step.title}</h4>
            <p class="text-[0.6875rem] leading-relaxed text-slate-500 dark:text-slate-400 m-0">{step.description}</p>
          </div>
          {index < 2 && (
            <div class="h-8 md:w-8 md:h-auto flex items-center justify-center shrink-0 animate-slide-down" style={`--delay: ${(index + 3) * 100 + 60}ms`}>
              <svg class="w-6 h-6 text-slate-400 dark:text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path class="chevron-desktop" d="M9 18l6-6-6-6" />
                <path class="chevron-mobile" d="M6 9l6 6 6-6" />
              </svg>
            </div>
          )}
        </>
        )
      })}
    </div>
  </div>

  <div class="mt-8">
    <AlertBox variant="info">
      A família pode reingressar no ciclo a qualquer momento, conforme novas demandas ou alterações na situação sociofamiliar identificadas pela equipe de referência.
    </AlertBox>
  </div>
</section>

<style>
  .chevron-mobile {
    display: block;
    animation: bounceDown 1.5s ease-in-out infinite;
  }

  .chevron-desktop {
    display: none;
    animation: bounceRight 1.5s ease-in-out infinite;
  }

  @media (min-width: 768px) {
    .chevron-mobile {
      display: none;
    }
    .chevron-desktop {
      display: block;
    }
  }

  @keyframes bounceDown {
    0%, 100% {
      transform: translateY(0);
      opacity: 0.3;
    }
    50% {
      transform: translateY(4px);
      opacity: 1;
    }
  }

  @keyframes bounceRight {
    0%, 100% {
      transform: translateX(0);
      opacity: 0.3;
    }
    50% {
      transform: translateX(4px);
      opacity: 1;
    }
  }
</style>
