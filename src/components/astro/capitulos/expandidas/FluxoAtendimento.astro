---
import SectionHeader from '@/components/astro/layout/SectionHeader.astro'

const cardVariantStyles = {
  familia: {
    card: 'border-purple-600 dark:border-purple-500 from-purple-50 to-white dark:from-purple-950/40 dark:to-slate-800',
    icon: 'from-purple-600 to-purple-500',
    title: 'text-purple-800 dark:text-purple-300',
    badge: 'bg-purple-600 text-white',
  },
  tecnico: {
    card: 'border-blue-600 dark:border-blue-500 from-blue-50 to-white dark:from-blue-950/40 dark:to-slate-800',
    icon: 'from-blue-600 to-blue-500',
    title: 'text-blue-800 dark:text-blue-300',
    badge: 'bg-blue-600 text-white',
  },
  prontuario: {
    card: 'border-cyan-600 dark:border-cyan-500 from-cyan-50 to-white dark:from-cyan-950/40 dark:to-slate-800',
    icon: 'from-cyan-600 to-cyan-500',
    title: 'text-cyan-800 dark:text-cyan-300',
    badge: 'bg-cyan-600 text-white',
  },
  rede: {
    card: 'border-green-600 dark:border-green-500 from-green-50 to-white dark:from-green-950/40 dark:to-slate-800',
    icon: 'from-green-600 to-green-500',
    title: 'text-green-800 dark:text-green-300',
    badge: 'bg-green-600 text-white',
  },
  evolucao: {
    card: 'border-indigo-600 dark:border-indigo-400 from-indigo-50 to-white dark:from-indigo-950/40 dark:to-slate-800',
    icon: 'from-indigo-600 to-indigo-500',
    title: 'text-indigo-800 dark:text-indigo-300',
    badge: 'bg-indigo-600 text-white',
  },
}
---

<div id="fluxo-atendimento" class="animate-fade-in bg-white dark:bg-slate-800 shadow-xl rounded-2xl p-8 md:p-16 mt-6">
  <SectionHeader title="Fluxo de Atendimento no Prontuário" accent="blue" />

  <div class="prose max-w-none text-slate-700 dark:text-slate-300 space-y-4 mb-8">
    <p>
      O Prontuário Eletrônico do SUAS organiza o fluxo de atendimento em etapas
      integradas, desde o primeiro contato da família com a unidade até o
      acompanhamento continuado. Cada etapa registra informações essenciais que
      compõem o histórico socioassistencial, permitindo que diferentes
      profissionais consultem a trajetória da família e tomem decisões
      fundamentadas. O diagrama abaixo representa esse percurso de forma linear,
      mas na prática o fluxo é cíclico: a reavaliação constante pode gerar novos
      encaminhamentos, reiniciando o ciclo de proteção.
    </p>
  </div>

  <!-- ============================================ -->
  <!-- FLUXO DE ATENDIMENTO — COLUNA ÚNICA VERTICAL -->
  <!-- ============================================ -->

  <div class="flex flex-col items-center max-w-lg mx-auto mb-8">

    <!-- CARD 1: Família -->
    <div class="w-full animate-fade-in">
      <div class={`flex items-center gap-3 p-3 md:p-4 rounded-xl border-2 bg-gradient-to-br shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all bg-white dark:bg-slate-800 ${cardVariantStyles.familia.card}`}>
        <div class={`w-10 h-10 rounded-xl flex items-center justify-center text-white bg-gradient-to-br shrink-0 ${cardVariantStyles.familia.icon}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
          </svg>
        </div>
        <div class="flex flex-col gap-0.5">
          <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider w-fit ${cardVariantStyles.familia.badge}`}>FAMÍLIA</span>
          <h3 class={`text-base font-bold m-0 ${cardVariantStyles.familia.title}`}>Família chega ao CRAS</h3>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 m-0">Primeiro contato com a unidade de referência</p>
        </div>
      </div>
    </div>

    <div class="connector-simple animate-fade-in">
      <svg class="arrow-chevron w-4 h-4 text-slate-400 dark:text-slate-500" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
    </div>

    <!-- CARD 2: Técnico -->
    <div class="w-full animate-fade-in">
      <div class={`flex items-center gap-3 p-3 md:p-4 rounded-xl border-2 bg-gradient-to-br shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all bg-white dark:bg-slate-800 ${cardVariantStyles.tecnico.card}`}>
        <div class={`w-10 h-10 rounded-xl flex items-center justify-center text-white bg-gradient-to-br shrink-0 ${cardVariantStyles.tecnico.icon}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 11l3 3L22 4" />
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
          </svg>
        </div>
        <div class="flex flex-col gap-0.5">
          <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider w-fit ${cardVariantStyles.tecnico.badge}`}>TÉCNICO</span>
          <h3 class={`text-base font-bold m-0 ${cardVariantStyles.tecnico.title}`}>Escuta qualificada e entrevista</h3>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 m-0">Técnico realiza acolhida e coleta de dados</p>
        </div>
      </div>
    </div>

    <div class="connector-simple animate-fade-in">
      <svg class="arrow-chevron w-4 h-4 text-slate-400 dark:text-slate-500" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
    </div>

    <!-- CARD 3: Prontuário -->
    <div class="w-full animate-fade-in">
      <div class={`flex items-center gap-3 p-3 md:p-4 rounded-xl border-2 bg-gradient-to-br shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all bg-white dark:bg-slate-800 ${cardVariantStyles.prontuario.card}`}>
        <div class={`w-10 h-10 rounded-xl flex items-center justify-center text-white bg-gradient-to-br shrink-0 ${cardVariantStyles.prontuario.icon}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="12" cy="5" rx="9" ry="3" />
            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
          </svg>
        </div>
        <div class="flex flex-col gap-0.5">
          <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider w-fit ${cardVariantStyles.prontuario.badge}`}>PRONTUÁRIO</span>
          <h3 class={`text-base font-bold m-0 ${cardVariantStyles.prontuario.title}`}>Dados registrados no Prontuário Eletrônico</h3>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 m-0">Informações organizadas no sistema SUAS</p>
        </div>
      </div>
    </div>

    <div class="connector-simple animate-fade-in">
      <svg class="arrow-chevron w-4 h-4 text-slate-400 dark:text-slate-500" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
    </div>

    <!-- CARD 4: Rede -->
    <div class="w-full animate-fade-in">
      <div class={`flex items-center gap-3 p-3 md:p-4 rounded-xl border-2 bg-gradient-to-br shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all bg-white dark:bg-slate-800 ${cardVariantStyles.rede.card}`}>
        <div class={`w-10 h-10 rounded-xl flex items-center justify-center text-white bg-gradient-to-br shrink-0 ${cardVariantStyles.rede.icon}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3" />
            <circle cx="6" cy="12" r="3" />
            <circle cx="18" cy="19" r="3" />
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
          </svg>
        </div>
        <div class="flex flex-col gap-0.5">
          <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider w-fit ${cardVariantStyles.rede.badge}`}>REDE</span>
          <h3 class={`text-base font-bold m-0 ${cardVariantStyles.rede.title}`}>Encaminhamentos para a rede</h3>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 m-0">Articulação com a rede socioassistencial</p>
        </div>
      </div>
    </div>

    <div class="connector-simple animate-fade-in">
      <svg class="arrow-chevron w-4 h-4 text-slate-400 dark:text-slate-500" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
    </div>

    <!-- CARD 5: Evolução -->
    <div class="w-full animate-fade-in">
      <div class={`flex items-center gap-3 p-3 md:p-4 rounded-xl border-2 bg-gradient-to-br shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all bg-white dark:bg-slate-800 ${cardVariantStyles.evolucao.card}`}>
        <div class={`w-10 h-10 rounded-xl flex items-center justify-center text-white bg-gradient-to-br shrink-0 ${cardVariantStyles.evolucao.icon}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
            <polyline points="17 6 23 6 23 12" />
          </svg>
        </div>
        <div class="flex flex-col gap-0.5">
          <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider w-fit ${cardVariantStyles.evolucao.badge}`}>EVOLUÇÃO</span>
          <h3 class={`text-base font-bold m-0 ${cardVariantStyles.evolucao.title}`}>Acompanhamento contínuo e reavaliação</h3>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 m-0">Monitoramento e atualização do histórico familiar</p>
        </div>
      </div>
    </div>

  </div>

  <!-- ============ CONVERGÊNCIA ============ -->
  <div class="flex justify-center max-w-xl mx-auto mb-8 animate-fade-in">
    <div class="flex items-center gap-3 px-4 py-2 rounded-full bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 shadow-sm">
      <div class="w-2 h-2 rounded-full bg-purple-500"></div>
      <div class="w-2 h-2 rounded-full bg-blue-500"></div>
      <div class="w-2 h-2 rounded-full bg-cyan-500"></div>
      <div class="w-2 h-2 rounded-full bg-green-500"></div>
      <span class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">Todos os registros convergem para o histórico da família</span>
    </div>
  </div>

  <style>
    .connector-simple {
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .arrow-chevron {
      animation: bounceDown 1.5s ease-in-out infinite;
    }

    @keyframes bounceDown {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(5px); }
    }
  </style>
</div>
