---
// Login no Sistema — passo a passo com screenshots
import LoginFlowModal from '@/components/react/content/LoginFlowModal.tsx'
---

<section id="login-sistema" class="animate-fade-in bg-white dark:bg-slate-800 shadow-xl rounded-2xl p-8 md:p-16 print:shadow-none print:rounded-none">
  <div class="flex items-center gap-3 mb-3">
    <div class="w-10 h-10 rounded-xl bg-institucional-blue flex items-center justify-center shadow-md shadow-institucional-blue/25">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    </div>
    <h2 class="text-3xl md:text-4xl font-extrabold text-slate-800 dark:text-white tracking-tight">Login no Sistema</h2>
  </div>

  <div class="h-1 w-20 rounded-full bg-gradient-to-r from-institucional-blue to-blue-300 mb-8" />

  <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-8 text-base">
    O login do sistema é realizado por meio das <strong class="text-slate-800 dark:text-white">contas ouro ou prata do sistema gov.br</strong>. A conta é gratuita e permite a identificação do usuário para acessar serviços digitais do governo federal. É necessário possuir <strong>cadastro no CadSUAS</strong> com um perfil de acesso autorizado — existem diversos perfis que permitem o acesso ao sistema, variando conforme a atuação e as atribuições de cada profissional na rede SUAS.
  </p>

  <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-8">
    <strong>Clique no botão abaixo</strong> para visualizar o fluxograma completo com todos os pré-requisitos, etapas de autenticação e ações pós-login.
  </p>

  <!-- ============================================ -->
  <!-- FLUXO DE LOGIN — BOTÃO PARA MODAL FULLSCREEN   -->
  <!-- ============================================ -->

  <div class="flex justify-center mb-8">
    <button
      onclick="window.openLoginFlowModal?.()"
      class="inline-flex items-center gap-3 px-6 py-4 rounded-2xl text-sm font-semibold bg-gradient-to-br from-white to-slate-50 dark:from-slate-800 dark:to-slate-800/60 border-2 border-dashed border-slate-300 dark:border-slate-600 shadow-sm hover:shadow-lg hover:border-institucional-blue dark:hover:border-institucional-blue hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200 group"
    >
      <span class="w-12 h-12 rounded-xl flex items-center justify-center bg-gradient-to-br from-institucional-blue to-institucional-blue/80 text-white shadow-md group-hover:scale-110 transition-transform duration-200">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>
      </span>
      <div class="text-left">
        <span class="block text-slate-800 dark:text-slate-100 group-hover:text-institucional-blue transition-colors">Ver fluxograma completo</span>
        <span class="block text-xs text-slate-500 dark:text-slate-400 mt-0.5">gov.br → Autorização → Seleção de perfil → Tela inicial</span>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 group-hover:text-institucional-blue transition-colors shrink-0"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
    </button>
  </div>

  <LoginFlowModal client:load />
</section>
