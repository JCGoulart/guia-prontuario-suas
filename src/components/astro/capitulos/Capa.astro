---
// Capa do Manual do Prontuário Eletrônico — SUAS / MDS
---

<section id="capa" class="animate-scale bg-white dark:bg-slate-800 shadow-xl rounded-2xl overflow-hidden print:shadow-none print:rounded-none break-after-page">
  <!-- Mobile SVG (400x600) -->
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 600" preserveAspectRatio="xMidYMid meet" class="md:hidden"><title>Manual do Prontuário Eletrônico — SUAS</title>
  <defs>
    <linearGradient id="mbg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#123e6b"/>
      <stop offset="100%" stop-color="#0b2d4f"/>
    </linearGradient>
    <linearGradient id="maccent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#1a7a3a"/>
      <stop offset="100%" stop-color="#25a34a"/>
    </linearGradient>
    <radialGradient id="mglow" cx="50%" cy="35%" r="60%">
      <stop offset="0%" stop-color="#1a7a3a" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#1a7a3a" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <rect width="400" height="600" fill="url(#mbg)"/>
  <rect width="400" height="600" fill="url(#mglow)"/>
  <rect x="0" y="0" width="400" height="10" fill="url(#maccent)"/>

  <g transform="translate(24, 38)">
    <text x="0" y="0" font-family="Inter, sans-serif" font-size="24" font-weight="600" fill="#a8c8e8" letter-spacing="1">MDS</text>
    <text x="0" y="26" font-family="Inter, sans-serif" font-size="11" font-weight="500" fill="#7fa5c8">Ministério do Desenvolvimento</text>
    <text x="0" y="40" font-family="Inter, sans-serif" font-size="11" font-weight="500" fill="#7fa5c8">e Assistência Social, Família</text>
    <text x="0" y="54" font-family="Inter, sans-serif" font-size="11" font-weight="500" fill="#7fa5c8">e Combate à Fome</text>
  </g>

  <g transform="translate(200, 170)">
    <circle cx="0" cy="0" r="45" fill="none" stroke="#1a7a3a" stroke-width="2.5" opacity="0.4"/>
    <circle cx="0" cy="0" r="32" fill="none" stroke="#1a7a3a" stroke-width="2" opacity="0.6"/>
    <circle cx="0" cy="0" r="20" fill="none" stroke="#1a7a3a" stroke-width="1.5" opacity="0.8"/>
    <g transform="translate(0, -10)">
      <rect x="-22" y="-28" width="44" height="32" rx="3" fill="#1a7a3a" opacity="0.9"/>
      <rect x="-16" y="-22" width="32" height="4" rx="2" fill="#ffffff" opacity="0.9"/>
      <rect x="-16" y="-14" width="24" height="4" rx="2" fill="#ffffff" opacity="0.6"/>
      <rect x="-16" y="-6" width="28" height="4" rx="2" fill="#ffffff" opacity="0.6"/>
    </g>
  </g>

  <g transform="translate(200, 295)" text-anchor="middle">
    <text x="0" y="0" font-family="Inter, sans-serif" font-size="16" font-weight="600" fill="#a8c8e8" letter-spacing="3">MANUAL DO</text>
    <text x="0" y="45" font-family="Inter, sans-serif" font-size="38" font-weight="800" fill="#ffffff" letter-spacing="-1">Prontuário</text>
    <text x="0" y="85" font-family="Inter, sans-serif" font-size="38" font-weight="800" fill="#1a7a3a" letter-spacing="-1">Eletrônico</text>
    <text x="0" y="118" font-family="Inter, sans-serif" font-size="16" font-weight="500" fill="#cfe5d8">Sistema Único de Assistência Social</text>
  </g>

  <g transform="translate(200, 450)" text-anchor="middle">
    <line x1="-80" y1="0" x2="80" y2="0" stroke="#1a7a3a" stroke-width="2"/>
    <text x="0" y="24" font-family="Inter, sans-serif" font-size="12" font-weight="500" fill="#a8c8e8">Guia de uso do sistema para</text>
    <text x="0" y="42" font-family="Inter, sans-serif" font-size="12" font-weight="500" fill="#a8c8e8">profissionais da assistência social</text>
  </g>

  <g transform="translate(20, 525)">
    <rect x="0" y="0" width="360" height="60" fill="#0b2d4f" rx="6"/>
    <text x="16" y="24" font-family="Inter, sans-serif" font-size="14" font-weight="700" fill="#ffffff">SUAS</text>
    <text x="16" y="42" font-family="Inter, sans-serif" font-size="9" font-weight="400" fill="#a8c8e8">Sistema Único de Assistência Social</text>
    <text x="344" y="24" font-family="Inter, sans-serif" font-size="10" font-weight="600" fill="#a8c8e8" text-anchor="end">MDS</text>
    <text x="344" y="42" font-family="Inter, sans-serif" font-size="8" font-weight="400" fill="#7fa5c8" text-anchor="end">Dezembro 2025</text>
  </g>

  <rect x="0" y="590" width="400" height="10" fill="url(#maccent)"/>
</svg>

  <!-- Desktop SVG (1200x1600) -->
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 1600" preserveAspectRatio="xMidYMid meet" class="hidden md:block"><title>Manual do Prontuário Eletrônico — SUAS</title>
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#123e6b"/>
      <stop offset="100%" stop-color="#0b2d4f"/>
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#1a7a3a"/>
      <stop offset="100%" stop-color="#25a34a"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#1a7a3a" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#1a7a3a" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <rect width="1200" height="1600" fill="url(#bg)"/>
  <rect width="1200" height="1600" fill="url(#glow)"/>

  <g opacity="0.06" stroke="#ffffff" stroke-width="1" fill="none">
    <path d="M 0 400 L 1200 400"/>
    <path d="M 0 600 L 1200 600"/>
    <path d="M 0 800 L 1200 800"/>
    <path d="M 0 1000 L 1200 1000"/>
    <path d="M 0 1200 L 1200 1200"/>
    <path d="M 300 0 L 300 1600"/>
    <path d="M 600 0 L 600 1600"/>
    <path d="M 900 0 L 900 1600"/>
  </g>

  <rect x="0" y="0" width="1200" height="20" fill="url(#accent)"/>

  <g transform="translate(80, 100)">
    <text x="0" y="0" font-family="Inter, sans-serif" font-size="22" font-weight="700" fill="#a8c8e8" letter-spacing="2">MDS</text>
    <text x="0" y="30" font-family="Inter, sans-serif" font-size="12" font-weight="500" fill="#7fa5c8">Ministério do Desenvolvimento e Assistência Social, Família e Combate à Fome</text>
  </g>

  <g transform="translate(600, 380)">
    <circle cx="0" cy="0" r="180" fill="none" stroke="#1a7a3a" stroke-width="3" opacity="0.4"/>
    <circle cx="0" cy="0" r="140" fill="none" stroke="#1a7a3a" stroke-width="2" opacity="0.6"/>
    <circle cx="0" cy="0" r="100" fill="none" stroke="#1a7a3a" stroke-width="1.5" opacity="0.8"/>
    <g transform="translate(0, -30)">
      <rect x="-90" y="-110" width="180" height="130" rx="8" fill="#1a7a3a" opacity="0.9"/>
      <rect x="-60" y="-80" width="120" height="14" rx="7" fill="#ffffff" opacity="0.9"/>
      <rect x="-60" y="-55" width="100" height="14" rx="7" fill="#ffffff" opacity="0.6"/>
      <rect x="-60" y="-30" width="110" height="14" rx="7" fill="#ffffff" opacity="0.6"/>
      <rect x="-60" y="-5" width="80" height="14" rx="7" fill="#ffffff" opacity="0.4"/>
    </g>
  </g>

  <g transform="translate(600, 780)" text-anchor="middle">
    <text x="0" y="0" font-family="Inter, sans-serif" font-size="22" font-weight="600" fill="#a8c8e8" letter-spacing="6">MANUAL DO</text>
    <text x="0" y="100" font-family="Inter, sans-serif" font-size="82" font-weight="800" fill="#ffffff" letter-spacing="-2">Prontuário</text>
    <text x="0" y="185" font-family="Inter, sans-serif" font-size="82" font-weight="800" fill="#1a7a3a" letter-spacing="-2">Eletrônico</text>
    <text x="0" y="240" font-family="Inter, sans-serif" font-size="22" font-weight="500" fill="#cfe5d8">Sistema Único de Assistência Social</text>
  </g>

  <g transform="translate(600, 1280)" text-anchor="middle">
    <line x1="-200" y1="0" x2="200" y2="0" stroke="#1a7a3a" stroke-width="2"/>
    <text x="0" y="36" font-family="Inter, sans-serif" font-size="16" font-weight="500" fill="#a8c8e8">Guia de uso do sistema para profissionais da assistência social</text>
  </g>

  <g transform="translate(80, 1460)">
    <rect x="0" y="0" width="1040" height="90" fill="#0b2d4f" rx="8"/>
    <text x="40" y="38" font-family="Inter, sans-serif" font-size="20" font-weight="700" fill="#ffffff">SUAS</text>
    <text x="40" y="62" font-family="Inter, sans-serif" font-size="14" font-weight="400" fill="#a8c8e8">Sistema Único de Assistência Social</text>
    <text x="1000" y="38" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#a8c8e8" text-anchor="end">MDS</text>
    <text x="1000" y="62" font-family="Inter, sans-serif" font-size="12" font-weight="400" fill="#7fa5c8" text-anchor="end">Dezembro 2025</text>
  </g>

  <rect x="0" y="1580" width="1200" height="20" fill="url(#accent)"/>
</svg>
</section>
