---
// Problemas Técnicos do Prontuário — página 18 do PDF
import AlertBox from '@/components/astro/content/AlertBox.astro'
---

<section
  id="problemas-tecnicos"
  class="animate-fade-in bg-white dark:bg-slate-800 shadow-xl rounded-2xl p-8 md:p-16 print:shadow-none print:rounded-none"
>
  <div class="flex items-center gap-3 mb-3">
    <div class="w-10 h-10 rounded-xl bg-red-600 flex items-center justify-center shadow-md shadow-red-600/25">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
        <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
    </div>
    <h2 class="text-3xl md:text-4xl font-extrabold text-slate-800 dark:text-white tracking-tight">
      Problemas Técnicos do Prontuário
    </h2>
  </div>

  <div class="h-1 w-20 rounded-full bg-gradient-to-r from-red-500 to-red-300 mb-8" />

  <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-8 text-base">
    O que fazer caso ocorra algum problema técnico durante a utilização do Prontuário SUAS.
  </p>

  <div class="space-y-6">
    <!-- Problemas Frequentes -->
    <AlertBox variant="warning" title="Problemas Frequentes">
      <div class="mt-2 space-y-2">
        <div class="flex items-center gap-3 text-sm">
          <span class="w-2 h-2 rounded-full bg-red-500 flex-shrink-0" />
          <span class="text-slate-600 dark:text-slate-300">Sistema fora do ar ou inoperante</span>
        </div>
        <div class="flex items-center gap-3 text-sm">
          <span class="w-2 h-2 rounded-full bg-amber-500 flex-shrink-0" />
          <span class="text-slate-600 dark:text-slate-300">Travamentos e lentidão</span>
        </div>
        <div class="flex items-center gap-3 text-sm">
          <span class="w-2 h-2 rounded-full bg-amber-500 flex-shrink-0" />
          <span class="text-slate-600 dark:text-slate-300">Não salva / não carrega</span>
        </div>
        <div class="flex items-center gap-3 text-sm">
          <span class="w-2 h-2 rounded-full bg-amber-500 flex-shrink-0" />
          <span class="text-slate-600 dark:text-slate-300">Dados não aparecem após inseridos</span>
        </div>
      </div>
    </AlertBox>

    <!-- Primeira Ação -->
    <AlertBox variant="info" title="Primeira Ação — Limpeza de Cache">
      <p class="text-sm leading-relaxed">
        Tente <strong>limpar o cache e os cookies</strong> do seu navegador ou utilizar uma <strong>aba anônima</strong> (modo incógnito). Muitos problemas de carregamento e lentidão são resolvidos com essa ação simples.
      </p>
    </AlertBox>

    <!-- Segunda Ação -->
    <AlertBox variant="info" title="Persistiu o Problema? Canais Oficiais">
      <p class="text-sm leading-relaxed">
        Caso o problema persista, entre em contato com os canais oficiais de comunicação do <strong>Ministério do Desenvolvimento Social (MDS)</strong> para registrar o chamado técnico.
      </p>
    </AlertBox>

    <!-- Canais de Comunicação -->
    <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-gradient-to-br from-slate-50 to-white dark:from-slate-800/60 dark:to-slate-900/30 p-6">
      <h4 class="font-bold text-sm text-slate-700 dark:text-slate-300 mb-4 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        Canais de Comunicação MDS
      </h4>
      <div class="space-y-3">
        <a
          href="https://falemds.centralit.com.br/atendimento/chatmds/index.html"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 hover:border-blue-300 dark:hover:border-blue-700 transition-colors group"
        >
          <span class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
          </span>
          <div class="flex-1">
            <span class="block text-sm font-medium text-slate-800 dark:text-white">FaleMDS</span>
            <span class="block text-xs text-slate-500 dark:text-slate-400">Registro de chamados técnicos</span>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 group-hover:text-blue-500 transition-colors"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
        </a>

        <div class="flex items-start gap-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3">
          <span class="w-8 h-8 rounded-lg bg-green-100 dark:bg-green-900/40 flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
          <div>
            <span class="block text-sm font-medium text-slate-800 dark:text-white">Telefone</span>
            <span class="block text-xs text-slate-500 dark:text-slate-400">121 ou 0800 707 2003</span>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3">
          <span class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-900/40 flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9333ea" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </span>
          <div>
            <span class="block text-sm font-medium text-slate-800 dark:text-white">E-mails</span>
            <span class="block text-xs text-slate-500 dark:text-slate-400">
              Vigilância: <a href="mailto:vigilanciasocial@mds.gov.br" class="text-blue-600 dark:text-blue-400 hover:underline">vigilanciasocial@mds.gov.br</a>
            </span>
            <span class="block text-xs text-slate-500 dark:text-slate-400">
              Rede SUAS: <a href="mailto:rede.suas@mds.gov.br" class="text-blue-600 dark:text-blue-400 hover:underline">rede.suas@mds.gov.br</a>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
