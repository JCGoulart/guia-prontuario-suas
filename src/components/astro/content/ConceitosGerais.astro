---
// Conceitos Gerais do Manual — seção extraída da Apresentação
import ConceitosFlowModal from '@/components/react/content/ConceitosFlowModal'
---

<section id="conceitos-gerais" class="animate-fade-in bg-white dark:bg-slate-800 shadow-xl rounded-2xl p-8 md:p-16 print:shadow-none print:rounded-none">
  <div class="flex items-center gap-3 mb-3">
    <div class="w-10 h-10 rounded-xl bg-institucional-blue flex items-center justify-center shadow-md shadow-institucional-blue/25">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    </div>
    <h2 class="text-3xl md:text-4xl font-extrabold text-slate-800 dark:text-white tracking-tight">Conceitos Gerais</h2>
  </div>

  <div class="h-1 w-20 rounded-full bg-gradient-to-r from-institucional-blue to-blue-300 mb-8" />

  <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
    Neste tópico você conhecerá conceitos importantes que auxiliarão na operação do Sistema Prontuário Eletrônico SUAS e na gestão dos dados nele inseridos e armazenados.
  </p>

  <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
    Os conceitos abordados incluem <strong>Família</strong>, <strong>Território</strong>, <strong>Atendimento</strong>, <strong>Acompanhamento Social</strong>, <strong>Articulação Intersetorial</strong>, <strong>Busca Ativa</strong>, <strong>Diagnóstico Social</strong>, <strong>Escuta Qualificada</strong> e <strong>Prática Reflexiva</strong> — cada um com definição e exemplos práticos do dia a dia no SUAS.
  </p>

  <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-8">
    <strong>Clique no botão abaixo</strong> para explorar todos os conceitos com suas descrições completas e exemplos práticos.
  </p>

  <!-- Botão para abrir diagrama interativo -->
  <div class="flex justify-center my-8">
    <button
      onclick="window.openConceitosFlowModal?.()"
      class="inline-flex items-center gap-3 px-6 py-4 rounded-2xl text-sm font-semibold bg-gradient-to-br from-white to-slate-50 dark:from-slate-800 dark:to-slate-800/60 border-2 border-dashed border-slate-300 dark:border-slate-600 shadow-sm hover:shadow-lg hover:border-institucional-blue dark:hover:border-institucional-blue hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200 group"
    >
      <span class="w-12 h-12 rounded-xl flex items-center justify-center bg-gradient-to-br from-institucional-blue to-institucional-blue/80 text-white shadow-md group-hover:scale-110 transition-transform duration-200">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </span>
      <div class="text-left">
        <span class="block text-slate-800 dark:text-slate-100 group-hover:text-institucional-blue transition-colors">Explorar conceitos</span>
        <span class="block text-xs text-slate-500 dark:text-slate-400 mt-0.5">10 conceitos fundamentais para o Prontuário SUAS</span>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 group-hover:text-institucional-blue group-hover:translate-x-0.5 transition-all"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>

  <ConceitosFlowModal client:load />
</section>
